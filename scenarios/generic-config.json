{
  "application": {
    "name": "My Application",
    "version": "2.1.0",
    "environment": "production",
    "settings": {
      "server": {
        "host": "0.0.0.0",
        "port": 8080,
        "ssl": {
          "enabled": true,
          "certificate": "/path/to/cert.pem",
          "key": "/path/to/key.pem",
          "protocols": ["TLSv1.2", "TLSv1.3"]
        },
        "middleware": [
          {
            "name": "cors",
            "enabled": true,
            "options": {
              "origin": "*",
              "methods": ["GET", "POST", "PUT", "DELETE"],
              "allowedHeaders": ["Content-Type", "Authorization"]
            }
          },
          {
            "name": "rateLimit",
            "enabled": true,
            "options": {
              "windowMs": 900000,
              "max": 100,
              "message": "Too many requests"
            }
          }
        ]
      },
      "database": {
        "primary": {
          "type": "postgresql",
          "host": "db.example.com",
          "port": 5432,
          "name": "myapp_prod",
          "pool": {
            "min": 2,
            "max": 10,
            "idle": 10000
          },
          "replication": {
            "enabled": true,
            "replicas": [
              {"host": "replica1.example.com", "port": 5432},
              {"host": "replica2.example.com", "port": 5432}
            ],
            "strategy": "round-robin"
          }
        },
        "cache": {
          "type": "redis",
          "host": "cache.example.com",
          "port": 6379,
          "db": 0,
          "ttl": 3600,
          "cluster": {
            "enabled": true,
            "nodes": [
              {"host": "cache1.example.com", "port": 6379},
              {"host": "cache2.example.com", "port": 6379},
              {"host": "cache3.example.com", "port": 6379}
            ]
          }
        }
      },
      "features": {
        "authentication": {
          "enabled": true,
          "providers": [
            {
              "type": "jwt",
              "secret": "supersecret",
              "expiresIn": "7d",
              "refreshToken": {
                "enabled": true,
                "expiresIn": "30d"
              }
            },
            {
              "type": "oauth2",
              "providers": {
                "google": {
                  "clientId": "xxx",
                  "clientSecret": "yyy",
                  "callbackUrl": "https://example.com/auth/google/callback"
                },
                "github": {
                  "clientId": "aaa",
                  "clientSecret": "bbb",
                  "callbackUrl": "https://example.com/auth/github/callback"
                }
              }
            }
          ]
        },
        "logging": {
          "level": "info",
          "format": "json",
          "transports": [
            {
              "type": "console",
              "colorize": true
            },
            {
              "type": "file",
              "filename": "/var/log/app.log",
              "maxSize": "20m",
              "maxFiles": 10,
              "compress": true
            },
            {
              "type": "syslog",
              "host": "syslog.example.com",
              "port": 514,
              "protocol": "udp"
            }
          ]
        },
        "monitoring": {
          "enabled": true,
          "metrics": {
            "provider": "prometheus",
            "endpoint": "/metrics",
            "interval": 30
          },
          "tracing": {
            "provider": "jaeger",
            "endpoint": "http://jaeger.example.com:14268/api/traces",
            "samplingRate": 0.1
          },
          "alerts": {
            "enabled": true,
            "channels": [
              {
                "type": "email",
                "recipients": ["admin@example.com", "ops@example.com"]
              },
              {
                "type": "slack",
                "webhook": "https://hooks.slack.com/services/xxx/yyy/zzz",
                "channel": "#alerts"
              }
            ]
          }
        }
      }
    }
  },
  "deployment": {
    "strategy": "blue-green",
    "automation": {
      "ci": {
        "provider": "github-actions",
        "triggers": ["push", "pull_request"],
        "stages": [
          {"name": "lint", "command": "npm run lint"},
          {"name": "test", "command": "npm test"},
          {"name": "build", "command": "npm run build"}
        ]
      },
      "cd": {
        "provider": "argocd",
        "repository": "https://github.com/example/gitops",
        "path": "apps/production",
        "syncPolicy": {
          "automated": true,
          "prune": true,
          "selfHeal": true
        }
      }
    },
    "rollback": {
      "enabled": true,
      "maxHistory": 5,
      "automatic": {
        "enabled": true,
        "conditions": [
          {"metric": "error_rate", "threshold": 5, "duration": "5m"},
          {"metric": "response_time", "threshold": 1000, "duration": "3m"}
        ]
      }
    }
  }
}
